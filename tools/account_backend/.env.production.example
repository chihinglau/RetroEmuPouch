# =================================================================
# RetroEmuPouch Account Backend — 生产环境变量模板
# 复制为 .env.production 后填入真实值
# .env.production 绝对不能提交到 Git！已在 .gitignore 中
# =================================================================

APP_NAME=RetroEmuPouch-AccountBackend
APP_ENV=prod
APP_PORT=8000
# CORS：生产只允许你的 App 域名和必要的跨域来源
APP_CORS_ORIGINS=https://api.yourdomain.com,https://yourdomain.com

# ── 数据库（docker-compose.prod.yml 里 db service 用）──
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD_HERE
# 内部连接（compose 里 app service 自动拼接）
DATABASE_URL=postgresql+psycopg://retroemupouch:CHANGE_ME@db:5432/retroemupouch

# ── JWT（必须至少 32 字节随机）──
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_48BYTE_RANDOM_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin 端点密钥（和 JWT_SECRET 不同，也必须随机）
ADMIN_TOKEN_SECRET=CHANGE_ME_TO_ANOTHER_48BYTE_RANDOM_SECRET

# 管理后台 Web UI 登录口令（/admin/ui/login），生产必须改成强口令
ADMIN_WEB_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_WEB_PASSWORD

# ── 收据校验凭证（Phase 5 接入后填入）──
# Google Play Service Account JSON → base64 编码后放这里
# cat service-account.json | base64 | pbcopy
GOOGLE_PLAY_SA_KEY_B64=
GOOGLE_PLAY_PACKAGE_NAME=com.retroemupouch.app

# 华为 IAP
HUAWEI_IAP_CLIENT_ID=
HUAWEI_IAP_CLIENT_SECRET=
HUAWEI_IAP_APP_ID=

# ── 安全 ──
# 盐值（至少 32 字节随机）
CLOUD_SAVE_KEY_SALT=CHANGE_ME_TO_RANDOM_SALT
DEVICE_ID_SALT=CHANGE_ME_TO_ANOTHER_RANDOM_SALT

# 生产环境关闭 dev mock
ALLOW_DEV_MOCK=false
