# ── 基础配置 ──
APP_NAME=RetroEmuPouch-AccountBackend
APP_ENV=dev                        # dev / staging / prod
APP_PORT=8000
APP_CORS_ORIGINS=*                 # prod 改为具体域名，逗号分隔

# ── 数据库 ──
DATABASE_URL=postgresql+psycopg://retroemupouch:changeme@localhost:5432/retroemupouch

# ── JWT ──
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_TOKEN_SECRET=another-separate-secret-for-admin-jwt

# ── 收据校验 (Phase 5 才需要) ──
# Google Play Developer Service Account JSON (生产时 base64 编码后注入)
GOOGLE_PLAY_SA_KEY_B64=
GOOGLE_PLAY_PACKAGE_NAME=com.retroemupouch.app

# 华为 IAP
HUAWEI_IAP_CLIENT_ID=
HUAWEI_IAP_CLIENT_SECRET=
HUAWEI_IAP_APP_ID=

# ── 合规/安全 ──
# 云存档客户端 key hash 的 salt (服务端只存 hash)
CLOUD_SAVE_KEY_SALT=
# device_id hash salt
DEVICE_ID_SALT=
# 是否允许 dev mock 收据校验 (dev/staging 开，prod 关)
ALLOW_DEV_MOCK=true
