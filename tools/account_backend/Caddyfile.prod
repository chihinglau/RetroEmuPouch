# =================================================================
# RetroEmuPouch Account Backend — Caddy 生产配置
# 自动申请/续期 Let's Encrypt SSL 证书
# 用法：把 DOMAIN 替换成你真实的域名
# =================================================================

# ── 主域名（自动 HTTPS）──
api.yourdomain.com {
    # 反向代理到后端 FastAPI（Caddy v2 标准写法；超时用默认值，
    # 后续接入真实验真时如需延长，在 transport http { response_header_timeout 120s } 配置）
    reverse_proxy app:8000

    # 健康检查端点直接透传
    handle /healthz {
        reverse_proxy app:8000
    }

    # 安全头；CORS 由后端 CORSMiddleware 统一处理，这里不再重复设置
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # 请求体大小由后端限制；Caddy v2 无 client_max_body_size 指令
    # 日志输出 stdout，用 docker compose logs caddy 查看（避免 /data/logs 目录不存在）
    log {
        output stdout
        format json
    }
}

# ── HTTP 强制跳转 HTTPS ──
http://api.yourdomain.com {
    redir https://api.yourdomain.com{uri} permanent
}

# ── 裸域名（可选，跳转到 api 子域）──
yourdomain.com {
    redir https://api.yourdomain.com{uri} permanent
}

http://yourdomain.com {
    redir https://api.yourdomain.com{uri} permanent
}
