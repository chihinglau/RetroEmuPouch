# =================================================================
# .dockerignore — Docker 构建时排除的文件
# =================================================================

# Git
.git
.gitignore
.github

# 开发环境
.env
.env.*.example
.dev.db
dev.db
*.log
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp

# 部署脚本（在主机上执行，不进镜像）
scripts/deploy.ps1
scripts/setup-ecs.sh

# 文档
docs/
*.md

# Alembic 迁移（生产用 compose exec app alembic 来跑，镜像里有 alembic 但不带迁移历史）
# 等等——alembic 目录需要进镜像！那不要排除。
