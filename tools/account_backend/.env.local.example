# =================================================================
# 本地部署环境变量（开发 + 内网穿透用）
# 复制为 .env.local 后填入真实值
# =================================================================

APP_NAME=RetroEmuPouch-AccountBackend
APP_ENV=local
APP_PORT=8000
APP_CORS_ORIGINS=*

# ── 数据库 ──
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://retroemupouch:CHANGE_ME@db:5432/retroemupouch

# ── JWT（dev 简单随机就行）──
JWT_SECRET=local_dev_jwt_secret_change_me_please_48bytes_minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin
ADMIN_TOKEN_SECRET=local_dev_admin_secret_change_me_please_48bytes

# ── 收据校验（本地不接真实平台）──
GOOGLE_PLAY_SA_KEY_B64=
GOOGLE_PLAY_PACKAGE_NAME=com.retroemupouch.app
HUAWEI_IAP_CLIENT_ID=
HUAWEI_IAP_CLIENT_SECRET=
HUAWEI_IAP_APP_ID=

# ── 安全盐 ──
CLOUD_SAVE_KEY_SALT=local_dev_salt_change_me
DEVICE_ID_SALT=local_dev_device_salt_change_me

# 本地开发开启 dev mock
ALLOW_DEV_MOCK=true
