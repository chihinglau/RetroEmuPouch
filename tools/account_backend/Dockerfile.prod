# =================================================================
# RetroEmuPouch Account Backend — 生产镜像（多阶段构建）
# =================================================================
FROM python:3.12-slim AS builder
WORKDIR /app

# requirements.txt 里的依赖（含 psycopg[binary] / bcrypt / cryptography）在
# cp312-linux-amd64 上都有 manylinux wheel，不需要编译工具链，因此整个 builder
# 不做 apt-get —— 大陆 ECS 上 deb.debian.org 的 apt update 曾卡十几分钟。
ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# 先装依赖（利用 Docker 缓存层）
COPY requirements.txt .
RUN pip install -r requirements.txt

# =================================================================
FROM python:3.12-slim
WORKDIR /app

# 运行时用户（非 root，安全）
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser

# 从 builder 复制 Python 环境
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 复制应用代码
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .

# 修正权限
RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import httpx; httpx.get('http://localhost:8000/healthz', timeout=3).raise_for_status()" || exit 1

# 默认启动（生产用 gunicorn + uvicorn worker）
# 2 核 2G ECS：单 worker 降低内存占用，配合 swap 使用
# 开发时可 override: docker run ... python -m uvicorn app.main:app --reload
CMD ["gunicorn", "app.main:app", \
     "--workers", "1", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
