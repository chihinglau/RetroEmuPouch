<?xml version="1.0" encoding="utf-8"?>
<!--
  Compliance P0-2: the `community` (sideload) flavour keeps LAN-HTTP behaviour
  so users can run the cloud service on their own PC over plain HTTP on a
  private subnet (e.g. http://192.168.x.y:8848). This flavour is NOT submitted
  to any app store.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
