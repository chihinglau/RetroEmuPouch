<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of the main network security config.

  Adds user-installed CA trust so a locally generated self-signed dev cert
  (e.g. tools/account_backend/localhost.pem) can be installed on the device for
  store-build HTTPS 联调. Release builds keep using the system-only main config
  and never trust user CAs.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
